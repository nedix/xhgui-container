{
  extends: [
    "https://raw.githubusercontent.com/nedix/actions/main/renovate-base.json5",
  ],
  customManagers: [
    {
      depNameTemplate: "PHP",
      fileMatch: ["^Containerfile$"],
      matchStrings: ["ARG PHP_VERSION=(?<currentValue>.*?)\\n"],
      datasourceTemplate: "docker",
      packageNameTemplate: "php",
    },
    {
      depNameTemplate: "XHGui",
      fileMatch: ["^Containerfile$"],
      matchStrings: ["ARG XHGUI_VERSION=(?<currentValue>.*?)\\n"],
      datasourceTemplate: "github-releases",
      packageNameTemplate: "perftools/xhgui",
    },
    {
      depNameTemplate: "XHProf PHP",
      fileMatch: ["^stacks/php/compose-xhgui.yml$"],
      matchStrings: ["image: wodby/php:(?<currentValue>\\d+\\.\\d+)-dev\\n"],
      datasourceTemplate: "docker",
      packageNameTemplate: "php",
    },
  ],
}
